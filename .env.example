# Copy to .env. Generate separate hex secrets; never commit .env.
APP_DOMAIN=localhost
DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD

# Ollama runs on your host or another trusted machine. It is not public-facing.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Optional OpenAI-compatible cloud provider. Only used when explicitly selected.
CLOUD_AI_BASE_URL=
CLOUD_AI_MODEL=
CLOUD_AI_API_KEY=
# Optional dedicated Fernet key; otherwise credentials use DJANGO_SECRET_KEY.
CONNECTOR_ENCRYPTION_KEY=

# Microsoft Entra sign-in is optional. Enable when the app registration is ready.
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_ALLOWED_OBJECT_IDS=
# Existing planner username to link to the single allowed Entra object ID.
ENTRA_LINK_USERNAME=
